 "undefined": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121001031210000032233\"></div>\n      <div class=\"row\" data-code=\"121131231210000031231210000032233\"></div>\n      <div class=\"row\" data-code=\"1210130231211312312100000302032233\"></div>\n      <div class=\"row\" data-code=\"1210130231211312312100000302132233\"></div>\n      <div class=\"row\" data-code=\"12101302312113123121000003021032233\"></div>\n    </div>",
 "undefined-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"121131231210000031231210000032233\"></div>\n      <div class=\"row\" data-code=\"1210130231211312312100000302032233\"></div>\n      <div class=\"rb-note\">It matches only itself, and no count I can set against it: <span class=\"gl sg\" data-s=\"undefined\"></span>.</div>\n    </div>",
