 "equal": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211013121000100302312110031210101130231211003121101003023121111321210130231211321211101312312101011332121110131231211010033312312030231211113212111013123121010113321210001013123121010113123121101003321211312312101011312312110100332233\" data-fold=\"1\"></div>\n    </div>",
 "copied": "<div class=\"copied\">\n      <div class=\"cp-label\">copied, not read</div>\n      <div class=\"cp-item\">Row-craft, a long run of it, and none of it hard: how many things a row holds; the thing standing at a named place in it; setting a new thing at the head of a row; the two-way sameness above, put to a hundred rows and true in every one. Copied whole. I wanted the bench.</div>\n      <div class=\"cp-item\">A two-thing row given a name of its own, and its two parts named first and second. It is the knot again in a plainer coat. Four lines, and I have them.</div>\n    </div>",
 "map": "<div class=\"rows\"><div class=\"row\" data-code=\"121000101322121111103021133021100302100010302110330231210010013212110031210101130231210013123121010113021033023212111110302113302110302100013021132233\" data-fold=\"1\"></div></div>",
 "reduce": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021010130231210010103123121010302321211111030211330211302111302101132233\"></div>\n    </div>",
 "map-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"121000101322121111103021133021100302100010302110330231210010013212110031210101130231210013123121010113021033023212111110302113302110302100013021132233\" data-fold=\"1\"></div>\n      <div class=\"row\" data-code=\"12113021010130231210010103123121010302321211111030211330211302111302101132233\"></div>\n      <div class=\"rb-note\">One act laid on every item of a row; and a whole row gathered back down to one — <span class=\"gl sg\" data-s=\"map\"></span>, and <span class=\"gl sg\" data-s=\"reduce\"></span>.</div>\n    </div>",
 "knot-again": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211103121010113212101013020302100330231211302030231212101013020331231210101132233\" data-fold=\"1\"></div>\n    </div>",
