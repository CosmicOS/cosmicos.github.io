[
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12100111000100003023121101312111011013023121110011302312100003212121111103021033121111000030231212101101031210111103321210101003021101133021302312100003021103021113021030211030213021001302103021130211030210013321212111110302103312111100013021332233\"></div>\n      <div class=\"more-note\">&hellip;and the same frame twice more, the mark turned over in one and standing at none in the other&hellip;</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121210110113121133212111011013121111000033023121001321211101110312111100003302312101101030211100101100302312100003021302101302103021103021113021132233\"></div>\n      <div class=\"more-note\">…one of the three, as it comes off the tones; the small number in it runs longer than I will copy…</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121210110113121133212111011013121111000133023121001321211101110312111100013321210101003021332233\"></div>\n    </div>",
 "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row hand\" data-hand=\"abridged\" data-of=\"12100111000100003023121101312111011013023121110011302312100003212121111103021033121111000030231212101101031210111103321210101003021101133021302312100003021103021113021030211030213021001302103021130211030210013321212111110302103312111100013021332233\"><span class=\"gl sg\" data-s=\"assume\"></span> <span class=\"gl sg\" data-s=\"proton\"></span> <span class=\"bit\">▪</span></div>\n      <div class=\"rb-note\">The lightest of the three it bid me take on trust, near one — and across the water Oram named it: the inflammable air. <span class=\"gl sg\" data-s=\"assume\"></span>, and true.</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12100103121111111132233\"></div>\n    </div>",
