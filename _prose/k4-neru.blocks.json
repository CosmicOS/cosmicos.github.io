[
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021110030231211113212103021130203302110003021110032233\"></div>\n      <div class=\"row\" data-code=\"12113021110130231211113212100302101302113302111013021011132233\"></div>\n      <div class=\"more-note\">…the claim holds, it keeps the near saying; the claim fails, it keeps the far one; the other is never looked at…</div>\n    </div>",
 "<div class=\"rows\"><div class=\"row\" data-code=\"1211013121210013121033023121100312101011302312111132121031231210101130213302130231210013123121010113023121210013121033023121011312312101011302132233\" data-fold></div></div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021302312121001312103302132233\"></div>\n      <div class=\"row\" data-code=\"1211302103023121210013121033021032233\"></div>\n      <div class=\"row\" data-code=\"12113021103023121210013121033021132233\"></div>\n      <div class=\"row\" data-code=\"12113021100030231212100131210330210032233\"></div>\n      <div class=\"row\" data-code=\"1211302111100030231212100131210330210132233\"></div>\n    </div>",
 "<div class=\"rows\"><div class=\"row\" data-code=\"12110131212131210013302312110031210101130231211003121101003023121111312312101011312312110100312312032233\" data-fold=\"1\"></div></div>",
 "<div class=\"rows\"><div class=\"row\" data-code=\"12110131212131210103302312110031210101130231211003121101003023121111312312101011312312131231211010032233\" data-fold=\"1\"></div></div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113123120302312121312100133123120312312032233\"></div>\n      <div class=\"row\" data-code=\"12113123120302312121312100133123120312312132233\"></div>\n      <div class=\"row\" data-code=\"12113123120302312121312100133123121312312032233\"></div>\n      <div class=\"row\" data-code=\"12113123121302312121312100133123121312312132233\"></div>\n      <div class=\"more-note\">…and the other sign, the mirror of it: yes if either wears yes…</div>\n      <div class=\"row\" data-code=\"12113123121302312121312101033123120312312132233\"></div>\n      <div class=\"row\" data-code=\"12113123120302312121312101033123120312312032233\"></div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121101312111011302312110031210101130231211003121101003023121213121010332121003123121010113123121101003321211312312101011312312110100332233\" data-fold=\"1\"></div>\n      <div class=\"row\" data-code=\"12110131211110030231211003121010113023121100312110100302312121312101033212103123121010113123121101003321211312312101011312312110100332233\" data-fold=\"1\"></div>\n    </div>",
 "<div class=\"copied\">\n      <div class=\"cp-label\">copied, not read</div>\n      <div class=\"cp-item\">Sixty-odd further postures of both and either, every pairing of yes and no and then the pairings again with the counting-marks standing in for the plain yeses. Copied entire. I read to the twentieth and could see where it was going.</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:0.0em\"><span class=\"say\">five, the claim holds — hand it four</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:1.4em\"><span class=\"say\">four, holds — hand it three</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:2.8em\"><span class=\"say\">three, holds — hand it two</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:4.2em\"><span class=\"say\">two, holds — hand it one</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:5.6em\"><span class=\"say\">one, and here the claim turns over. The count slips under one and it keeps the plain saying instead of calling again</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:4.2em\"><span class=\"say\">two, takes back one, and heaps: two</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:2.8em\"><span class=\"say\">three, takes back two, and heaps: six</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:1.4em\"><span class=\"say\">four, takes back six, and heaps: twenty-four</span></div>\n      <div class=\"row hand\" data-hand=\"hers\" style=\"padding-left:0.0em\"><span class=\"say\">five, takes back twenty-four, and heaps: a hundred and twenty</span></div>\n    </div>"
]