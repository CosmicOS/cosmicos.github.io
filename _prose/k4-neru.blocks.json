{
  "rows": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021110030231211113212103021130203302110003021110032233\"></div>\n      <div class=\"row\" data-code=\"12113021110130231211113212100302101302113302111013021011132233\"></div>\n      <div class=\"more-note\">…the claim holds, it keeps the near saying; the claim fails, it keeps the far one; the other is never looked at…</div>\n    </div>",
  "factorial": "<div class=\"rows\"><div class=\"row\" data-code=\"1211013121210013121033023121100312101011302312111132121031231210101130213302130231210013123121010113023121210013121033023121011312312101011302132233\" data-fold></div></div>",
  "factorial-2": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021302312121001312103302132233\"></div>\n      <div class=\"row\" data-code=\"1211302103023121210013121033021032233\"></div>\n      <div class=\"row\" data-code=\"12113021103023121210013121033021132233\"></div>\n      <div class=\"row\" data-code=\"12113021100030231212100131210330210032233\"></div>\n      <div class=\"row\" data-code=\"1211302111100030231212100131210330210132233\"></div>\n    </div>",
  "and": "<div class=\"rows\"><div class=\"row\" data-code=\"12110131212131210013302312110031210101130231211003121101003023121111312312101011312312110100312312032233\" data-fold></div></div>",
  "or": "<div class=\"rows\"><div class=\"row\" data-code=\"12110131212131210103302312110031210101130231211003121101003023121111312312101011312312131231211010032233\" data-fold></div></div>",
  "and-2": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113123120302312121312100133123120312312032233\"></div>\n      <div class=\"row\" data-code=\"12113123120302312121312100133123120312312132233\"></div>\n      <div class=\"row\" data-code=\"12113123120302312121312100133123121312312032233\"></div>\n      <div class=\"row\" data-code=\"12113123121302312121312100133123121312312132233\"></div>\n      <div class=\"more-note\">…and the other sign, the mirror of it: yes if either wears yes…</div>\n      <div class=\"row\" data-code=\"12113123121302312121312101033123120312312132233\"></div>\n      <div class=\"row\" data-code=\"12113123120302312121312101033123120312312032233\"></div>\n    </div>",
  "or-2": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121101312111011302312110031210101130231211003121101003023121213121010332121003123121010113123121101003321211312312101011312312110100332233\" data-fold></div>\n      <div class=\"row\" data-code=\"12110131211110030231211003121010113023121100312110100302312121312101033212103123121010113123121101003321211312312101011312312110100332233\" data-fold></div>\n    </div>",
  "copied": "<div class=\"copied\">\n      <div class=\"cp-label\">copied, not read</div>\n      <div class=\"cp-item\">Sixty-odd further postures of both and either, every pairing of yes and no and then the pairings again with the counting-marks standing in for the plain yeses. Copied entire. I read to the twentieth and could see where it was going.</div>\n    </div>",
  "fork-again": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021110130231211113212100302101302113302111013021011132233\"></div>\n    </div>",
  "both-either-again": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12110131212131210013302312110031210101130231211003121101003023121111312312101011312312110100312312032233\"></div>\n      <div class=\"row\" data-code=\"12110131212131210103302312110031210101130231211003121101003023121111312312101011312312131231211010032233\"></div>\n    </div>",
  "empty-name-cup-check": "<div class=\"peel\">\n      <div class=\"msg-line\"><span class=\"lbl\">one behind it, and the line goes on</span>\n        <div class=\"row\" data-retrieved=\"p288\" data-code=\"121130210302312111031210101130213023121010312312101011302132233\"></div>\n        <span class=\"peel-say\">the count after it stands on its own; a mark that ran to the end would have swallowed it</span></div>\n      <div class=\"msg-line\"><span class=\"lbl\">twice on one line</span>\n        <div class=\"row\" data-retrieved=\"p288\" data-code=\"1211103121010113021003023121130210000302312100131231210101131231210101132233\"></div>\n        <span class=\"peel-say\">each takes the one name behind it and lets go</span></div>\n    </div>"
}
