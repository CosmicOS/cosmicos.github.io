{
  "rows": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121130211030211032233\"></div>\n      <div class=\"row\" data-code=\"1211302110321210103021302101332233\"></div>\n      <div class=\"row\" data-code=\"121130211030231210103021321210103021003021332233\"></div>\n      <div class=\"more-note\">…then it lets both sides swell at once, and holds them equal still…</div>\n      <div class=\"row\" data-code=\"12113212101030211302113321210103021302101332233\"></div>\n      <div class=\"row\" data-code=\"12113212101030211321210113021013021033321210103021302101332233\"></div>\n    </div>",
  "rows-2": "<div class=\"rows\"><div class=\"row\" data-code=\"121130211030231210103021321210103021003021332233\" data-fold></div></div>",
  "rows-3": "<div class=\"rows\"><div class=\"row\" data-code=\"12111031210101130213023121132121010113302132233\" data-fold></div></div>",
  "rows-4": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12111031210101132121010330231211302111321210101130210030211332233\" data-fold></div>\n      <div class=\"more-note\">…and two names at once in one breath, each holding its own, join them and it is true…</div>\n    </div>",
  "rows-5": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113020302321211003121010113123121010113302032233\"></div>\n      <div class=\"row\" data-code=\"121130210130232121100312101011312312101011330210132233\"></div>\n    </div>",
  "rows-6": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121130203023212110031210101130231210013123121010113123121010113302032233\"></div>\n      <div class=\"row\" data-code=\"121130213023212110031210101130231210013123121010113123121010113302132233\"></div>\n      <div class=\"row\" data-code=\"121130210030232121100312101011302312100131231210101131231210101133021032233\"></div>\n      <div class=\"row\" data-code=\"1211302100130232121100312101011302312100131231210101131231210101133021132233\"></div>\n      <div class=\"row\" data-code=\"121130210000302321211003121010113023121001312312101011312312101011330210032233\"></div>\n      <div class=\"row\" data-code=\"121130211001302321211003121010113023121001312312101011312312101011330210132233\"></div>\n    </div>",
  "reduce": "<div class=\"reduce\">\n      <div><span class=\"gl sg\" data-s=\"?\"></span> <span class=\"gl sg\" data-s=\"x\"></span> <span class=\"cup o\">⟅</span><span class=\"gl sg\" data-s=\"*\"></span> <span class=\"gl sg\" data-s=\"x\"></span> <span class=\"gl sg\" data-s=\"x\"></span><span class=\"cup c\">⟆</span> <span class=\"num barred\" data-n=\"2\"></span><span class=\"say\">the maker, and a two to pour in</span></div>\n      <div><span class=\"step\">becomes</span> <span class=\"cup o\">⟅</span><span class=\"gl sg\" data-s=\"*\"></span> <span class=\"num barred\" data-n=\"2\"></span> <span class=\"num barred\" data-n=\"2\"></span><span class=\"cup c\">⟆</span><span class=\"say\">the two poured into each place the slot marked</span></div>\n      <div><span class=\"step\">becomes</span> <span class=\"num barred\" data-n=\"4\"></span><span class=\"say\">two against two &mdash; four, the square I already held</span></div>\n    </div>",
  "rows-7": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121130210030232121100312101030231210013123121010312312101033021032233\"></div>\n    </div>",
  "rows-8": "<div class=\"rows\"><div class=\"row\" data-code=\"1211103121010113212110031211010030231210013123121101003123121101003302312113021100130231210101130210132233\" data-fold></div></div>",
  "maker-in-maker": "<div class=\"rows\">\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"121130211010030232121100312101011302312110031211010030231210013123121010113123121101003302110130210032233\"><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"gl sg\" data-s=\"?\"></span> <span class=\"gl sg\" data-s=\"x\"></span> <span class=\"nil\">◇</span> <span class=\"gl sg\" data-s=\"?\"></span> <span class=\"gl sg\" data-s=\"y\"></span> <span class=\"nil\">◇</span> <span class=\"gl sg\" data-s=\"*\"></span> <span class=\"nil n\">◆</span><span class=\"gl sg\" data-s=\"x\"></span> <span class=\"nil n\">◆</span><span class=\"gl sg\" data-s=\"y\"></span><span class=\"cup c\">⟆</span></span></div>\n    </div>",
  "rows-9": "<div class=\"rows\"><div class=\"row\" data-code=\"121130211010030232121100312101011302312110031211010030231210013123121010113123121101003302110130210032233\" data-fold></div></div>",
  "meaning-of-life-universe-everything": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12110131211100130210011132233\"></div>\n      <div class=\"more-note\">…a season of other sayings, and then it comes back to this one…</div>\n      <div class=\"row\" data-code=\"121131231211100130210011132233\"></div>\n    </div>",
  "meaning-of-life-universe-everything-2": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12110131211100130210100032233\"></div>\n      <div class=\"row\" data-code=\"1211013121110013023121010302131231211100132233\"></div>\n      <div class=\"row\" data-code=\"121131231211100130210100132233\"></div>\n    </div>",
  "square": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211013121100103023121100312101011302312100131231210101131231210101132233\"></div>\n      <div class=\"row\" data-code=\"121130210013023121100103021132233\"></div>\n      <div class=\"row\" data-code=\"12113021003023121100103021032233\"></div>\n      <div class=\"more-note\">…and ever after, that mark <em>is</em> the squaring; it need never show me the making again…</div>\n    </div>",
  "rows-10": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211013121302312113020302032233\"></div>\n      <div class=\"row\" data-code=\"1211013120302312113020302132233\"></div>\n    </div>",
  "msg": "<div class=\"msg\" data-msg=\"fragment\" data-src=\"= 0 0\" data-parse='[\"=\",\"0\",\"0\"]' data-tones=\"12113020302032233\" data-value='true' data-glyphs=\"&#x2843;&#x2886;&#x28c0;&#x2886;&#x28c0;&#x2887;\"></div>",
  "msg-2": "<div class=\"msg\" data-msg=\"fragment\" data-src=\"= 0 1\" data-parse='[\"=\",\"0\",\"1\"]' data-tones=\"12113020302132233\" data-value='false' data-glyphs=\"&#x2843;&#x2886;&#x28c0;&#x2886;&#x28c1;&#x2887;\"></div>",
  "rows-11": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121131231213212113021030210332233\"></div>\n      <div class=\"row\" data-code=\"12113123121321210030210030210332233\"></div>\n      <div class=\"row\" data-code=\"1211312312032121030210030210332233\"></div>\n      <div class=\"more-note\">…and the same verdict read the other way round, the claim set down first…</div>\n      <div class=\"row\" data-code=\"121132121130211302103312312032233\"></div>\n      <div class=\"more-note\">…holding is holding; and holding is not failing…</div>\n      <div class=\"row\" data-code=\"12113123121312312132233\"></div>\n      <div class=\"row\" data-code=\"12101302312113123121312312032233\"></div>\n    </div>",
  "readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"1211013121302312113020302032233\"></div>\n      <div class=\"row\" data-code=\"1211013120302312113020302132233\"></div>\n      <div class=\"row\" data-code=\"121131231213212113021030210332233\"></div>\n      <div class=\"row\" data-code=\"121132121130211302103312312032233\"></div>\n      <div class=\"rb-note\">The two makings first, wearing the words I gave them. Then: ask a saying whether it is so — two of a kind, and it wears <span class=\"gl sg\" data-s=\"true\"></span>; two that differ, and it wears <span class=\"gl sg\" data-s=\"false\"></span>.</div>\n    </div>",
  "lend-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"12111031210101130213023121132121010113302132233\"></div>\n      <div class=\"rb-note\">The mark holding the count for the length of the saying, and nothing after: <span class=\"gl sg\" data-s=\"assign\"></span>.</div>\n    </div>",
  "maker-again": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113020302321211003121010113123121010113302032233\"></div>\n    </div>",
  "keep-again": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12110131211100130210011132233\"></div>\n    </div>"
