  "point": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12100103121001001132233\" data-fold></div>\n      <div class=\"row\" data-code=\"1211302101130232121001001130210113021100331210101132233\"></div>\n      <div class=\"row\" data-code=\"12110131210010110302312100100113021302101132233\"></div>\n      <div class=\"row\" data-code=\"1211013121001011130231210010011302103021011032233\"></div>\n      <div class=\"row\" data-code=\"1211302101103023121001011131211010032233\"></div>\n    </div>",
  "cell-test2-cell-test3": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211302100001302321210010110312101031231210010111331211010032233\"></div>\n      <div class=\"row\" data-code=\"121001011031210103123121001011131211302312100100113021130210000132233\"></div>\n      <div class=\"row\" data-code=\"121001011131210103123121001011031211302312100100113021130210000132233\"></div>\n    </div>",
  "pocket-add": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121001110131210011011302100110132233\"></div>\n      <div class=\"more-note\">…and again, and again, two more dropped in the same way…</div>\n      <div class=\"row\" data-code=\"121211010113121133212100111013121001101033023121000030210011013021011000302110001132233\"></div>\n      <div class=\"row\" data-code=\"121001110131210011100302101100032233\"></div>\n      <div class=\"row\" data-code=\"12121101011312113321210011101312100110103302312100003021001101302110001132233\"></div>\n    </div>",
  "pocket-add-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"121001110131210011011302100110132233\"></div>\n      <div class=\"row\" data-code=\"121001110131210011100302101100032233\"></div>\n      <div class=\"rb-note\">Drop a thing in and it keeps it; ask it back and it lets that one go and minds the rest — <span class=\"gl sg\" data-s=\"pocket\"></span>.</div>\n    </div>",
  "pocket-container": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12110131210011101302312100110003121001111032233\"></div>\n      <div class=\"row\" data-code=\"12110131210011111302312100110003121001111032233\"></div>\n    </div>",
  "unique-new": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113020302312101001113121001111032233\"></div>\n      <div class=\"row\" data-code=\"12113021302312101001113121001111032233\"></div>\n      <div class=\"row\" data-code=\"121013023121132121010011131210011110332121010011131210011110332233\"></div>\n    </div>",
  "unique-new-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"121013023121132121010011131210011110332121010011131210011110332233\"></div>\n      <div class=\"rb-note\">Two stamped alike in every count, and still not one thing but two — each minted a mark shared with nothing else that will ever be: <span class=\"gl sg\" data-s=\"unique\"></span>.</div>\n    </div>",
  "cell-test1-cell": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211013121011111130231210010131210011110302111132233\"></div>\n      <div class=\"row\" data-code=\"121130211113023121011111131211110132233\"></div>\n      <div class=\"row\" data-code=\"12101111113121101011302101001032233\"></div>\n      <div class=\"row\" data-code=\"121130210100103023121011111131211110132233\"></div>\n    </div>",
  "hall-room": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121101312110010013023121100010031210011110302032233\"></div>\n    </div>",
  "door1-door": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121101312110010113023121100001031210011110312312110010013123121100101032233\"></div>\n      <div class=\"row\" data-code=\"2121100101131211000110312312110010013312101100113123121100101032233\"></div>\n      <div class=\"row\" data-code=\"2121100101131211000110312312110010103312101100113123121100100132233\"></div>\n    </div>",
  "door2-door": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121101312110100003023121100001031210011110312312110010013123121100110132233\"></div>\n      <div class=\"row\" data-code=\"121101312110100013023121100001031210011110312312110010013123121100110032233\"></div>\n      <div class=\"row\" data-code=\"121101312110100103023121100001031210011110312312110011003123121100111032233\"></div>\n      <div class=\"more-note\">…and the shape they make, as I drew it to hold in my head — the middle, three off it, and one leading on and up:…</div>\n    </div>",
  "fold": "<div class=\"fold\"><span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▫</span> <span class=\"gl sg\" data-s=\"door\"></span> <span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▪</span>\n<span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▫</span> <span class=\"gl sg\" data-s=\"door\"></span> <span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▪▫</span> <span class=\"gl sg\" data-s=\"door\"></span> <span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▪▫▫</span>\n<span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▫</span> <span class=\"gl sg\" data-s=\"door\"></span> <span class=\"gl sg\" data-s=\"room\"></span><span class=\"bit\">▪▪</span></div>",
  "myrobo-robo": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12110131211101001302312111000003121001111032233\"></div>\n      <div class=\"row\" data-code=\"1211101001312110101013123121100110032233\"></div>\n    </div>",
  "held-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"12100010132121111101312101011302302130210302113302312100003021302103021132233\"></div>\n      <div class=\"row\" data-code=\"121000101321211111013121010113023021330231210000302132233\"></div>\n      <div class=\"rb-note\">A held run set against a plain row of the same parts, and they answer alike: <span class=\"gl sg\" data-s=\"quote\"></span>.</div>\n    </div>",
  "kind-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"1210001001312110001302101032233\"></div>\n      <div class=\"row\" data-code=\"12101302312100010013121100013123121001011032233\"></div>\n      <div class=\"rb-note\">One that is a count and one that isn't, and the kind it asks after named in the line: <span class=\"gl sg\" data-s=\"instanceof\"></span>.</div>\n    </div>"
