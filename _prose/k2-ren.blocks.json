[
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12100103121132233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213020332121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"more-note\">…and on, the same, more times than I will copy…</div>\n      <div class=\"row\" data-code=\"12100103121032233\"></div>\n      <div class=\"row\" data-code=\"121001031210032233\"></div>\n      <div class=\"row\" data-code=\"121032121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1210321211130213020332121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12100321211130213021302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"1210032121113021302130213021302033212111302130213020332233\"></div>\n    </div>",
 "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"1211321211130213021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121032121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12100321211130213021302130203321211130213020332233\"></div>\n      <div class=\"rb-note\">Two counts that match, I mark <span class=\"gl sg\" data-s=\"=\"></span>; where they lean, fewer or more.</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121001031210132233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12101302312103212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121013023121003212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"more-note\">…and so, again and again: the true thing said plain, the two false ones denied…</div>\n    </div>",
 "<div class=\"copied\">\n      <div class=\"cp-label\">copied, not read</div>\n      <div class=\"cp-item\">Forty-odd more of the same posture. Deny before a false claim, never before a true one. I read six and stopped.</div>\n    </div>",
 "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1210130231211321211130213021302130213020332121113020332233\"></div>\n      <div class=\"rb-note\">Nothing in front of the true one. <span class=\"gl w\" data-sign=\"not\">deny</span> in front of the one that is not so.</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1210010312101032233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302033023121010321211130213021302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130213020330231210103212111302130213021302130203321211130213020332233\"></div>\n      <div class=\"more-note\">…and more of the same, each true when I count it…</div>\n    </div>",
 "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"></div>\n      <div class=\"rb-note\">Two heaps poured into one, and it minds not which I set first: join.</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1210010312101132233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203302312101132121113021302130213021302130203321211130213020332233\"></div>\n      <div class=\"more-note\">…and on, always true when I count it…</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211321211130213020330231210013212111302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130203302312100132121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302033023121001321211130213021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302130213020330231210013212111302130213020332121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302130213021302130213021302130203302312100132121113021302130213020332121113021302130213020332233\"></div>\n      <div class=\"more-note\">…every count against every count, more than I will copy…</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211302103212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113021132121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211302100321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113021013212111302130213021302130213020332233\"></div>\n      <div class=\"more-note\">…up to that same height, a digit shy of full, and past it — a fistful of marks shrunk each time to a handful of tones…</div>\n    </div>",
 "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211302100130231210103021103021132233\"></div>\n      <div class=\"row\" data-code=\"12113021003023121001302103021032233\"></div>\n    </div>"
]