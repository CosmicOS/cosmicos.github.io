{
  "rows-head": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12100103121132233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302033212111302130213020332233\"></div>\n    </div>",
  "rows": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12100103121132233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213020332121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"more-note\">…and on, the same, more times than I will copy…</div>\n      <div class=\"row\" data-code=\"12100103121032233\"></div>\n      <div class=\"row\" data-code=\"121001031210032233\"></div>\n      <div class=\"row\" data-code=\"121032121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1210321211130213020332121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12100321211130213021302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"1210032121113021302130213021302033212111302130213020332233\"></div>\n    </div>",
  "no-mark-in-front": "<div class=\"peel\">\n      <div class=\"msg-line\"><span class=\"lbl\">my first, as I have it</span>\n        <div class=\"row\" data-code=\"12100103121132233\"></div>\n        <span class=\"peel-say\">sarn brings a mark in, and that is all of it</span></div>\n      <div class=\"msg-line\"><span class=\"lbl\">as it came</span>\n        <span class=\"frag msg-view\" data-code=\"12100103121132233\" data-view=\"atoms\"></span>\n        <span class=\"peel-say\">two of them, each a mark with its cup, then the seam</span></div>\n    </div>\n    <div class=\"peel\">\n      <div class=\"msg-line\"><span class=\"lbl\">my second, as I have it</span>\n        <div class=\"row\" data-code=\"12113212111302130203321211130213020332233\"></div>\n        <span class=\"peel-say\">one weighed against one, and it says they match</span></div>\n      <div class=\"msg-line\"><span class=\"lbl\">as it came</span>\n        <span class=\"frag msg-view\" data-code=\"12113212111302130203321211130213020332233\" data-view=\"atoms\"></span>\n        <span class=\"peel-say\">the same saying, every mark of it</span></div>\n    </div>",
  "rows-2": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"121001031210132233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12101302312103212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121013023121003212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"more-note\">…and so, again and again: the true thing said plain, the two false ones denied…</div>\n    </div>",
  "copied": "<div class=\"copied\">\n      <div class=\"cp-label\">copied, not read</div>\n      <div class=\"cp-item\">Forty-odd more of the same posture. Deny before a false claim, never before a true one. I read six and stopped.</div>\n    </div>",
  "unary-readback-2": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1210130231211321211130213021302130213020332121113020332233\"></div>\n      <div class=\"rb-note\">Nothing in front of the true one. <span class=\"gl w\" data-sign=\"not\">deny</span> in front of the one that is not so.</div>\n    </div>",
  "rows-3": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1210010312101032233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302033023121010321211130213021302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130213020330231210103212111302130213021302130203321211130213020332233\"></div>\n      <div class=\"more-note\">…and more of the same, each true when I count it…</div>\n    </div>",
  "unary-readback-3": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"></div>\n      <div class=\"rb-note\">Two heaps poured into one, and it minds not which I set first: join.</div>\n    </div>",
  "exhibit": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1210010312101132233\"></div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203302312101132121113021302130213021302130203321211130213020332233\"></div>\n      <div class=\"more-note\">…and on, always true when I count it…</div>\n    </div>",
  "unary": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1210010312100132233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213020330231210013212111302130203321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130203302312100132121113021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302033023121001321211130213021302033212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302130213020330231210013212111302130213020332121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211321211130213021302130213021302130213021302130203302312100132121113021302130213020332121113021302130213020332233\"></div>\n      <div class=\"more-note\">…every count against every count, more than I will copy…</div>\n    </div>",
  "unary-2": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"12113021321211130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211302103212111302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113021132121113021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"1211302100321211130213021302130213020332233\"></div>\n      <div class=\"row\" data-code=\"12113021013212111302130213021302130213020332233\"></div>\n      <div class=\"more-note\">…up to that same height, one short of the feet, and past it — a scatter of marks shrunk each time to a few tones…</div>\n    </div>",
  "rows-4": "<div class=\"rows\">\n      <div class=\"row\" data-code=\"1211302100130231210103021103021132233\"></div>\n      <div class=\"row\" data-code=\"12113021003023121001302103021032233\"></div>\n    </div>",
  "unary-readback-4": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"rows labeled\">\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"121001031211132233\"><span class=\"lbl\">as Maren had it</span><span class=\"fig\"><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▪▪</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"121001031211132233\"><span class=\"lbl\">the count in its cup</span><span class=\"fig\"><span class=\"bit\">▪▪▪</span></span></div>\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"121001031211132233\"><span class=\"lbl\">as I write it</span><span class=\"fig\"><span class=\"gl sg\" data-s=\"unary\"></span></span></div>\n      </div>\n    </div>",
  "laid-against": "<div class=\"rows labeled\">\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"1212110000312110001330231211130213021302032233\"><span class=\"lbl\">hers, as she left it</span><span class=\"fig\"><span class=\"nil w\">tally</span> <span class=\"tk\">●●</span><span class=\"tk z\">◦</span></span></div>\n      <div class=\"row hand\" data-hand=\"undecoded\" data-of=\"1212110000312110001330231211130213021302032233\"><span class=\"lbl\">hers, before she shortened it</span><span class=\"fig\"><span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"cup c\">⟆</span> <span class=\"gl sg\" data-s=\"unary\"></span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▫</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"undecoded\" data-of=\"1211321211130213021302033212111302130213020332233\"><span class=\"lbl\">mine, tonight</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"gl sg\" data-s=\"unary\"></span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span></span></div>\n    </div>",
  "tal-cut": "<div class=\"rows labeled\">\n      <div class=\"row hand\" data-hand=\"undecoded\" data-of=\"1211321211130213021302033212111302130213020332233\"><span class=\"lbl\">as it comes</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▪▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup c\">⟆</span> <span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"bit\">▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"1211321211130213021302033212111302130213020332233\"><span class=\"lbl\">her marks, in a cup</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▪▪</span><span class=\"cup c\">⟆</span> <span class=\"tk\">●●</span><span class=\"tk z\">◦</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"1211321211130213021302033212111302130213020332233\"><span class=\"lbl\">and the long run as tal</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"gl w\">tal</span> <span class=\"tk\">●●</span><span class=\"tk z\">◦</span><span class=\"cup c\">⟆</span></span></div>\n    </div>",
  "nil-cut": "<div class=\"rows labeled\">\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"><span class=\"lbl\">as I have had it</span><span class=\"fig\"><span class=\"bit\">▫</span><span class=\"cup o\">⟅</span><span class=\"cup c\">⟆</span> <span class=\"gl w\">join</span> <span class=\"cup o\">⟅</span><span class=\"gl w\">tal</span> <span class=\"tk\">●</span><span class=\"tk z\">◦</span><span class=\"cup c\">⟆</span> <span class=\"cup o\">⟅</span><span class=\"gl w\">tal</span> <span class=\"tk\">●●</span><span class=\"tk z\">◦</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"notation\" data-of=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"><span class=\"lbl\">as I write it from tonight</span><span class=\"fig\"><span class=\"nil\">◇</span> <span class=\"gl w\">join</span> <span class=\"cup o\">⟅</span><span class=\"gl w\">tal</span> <span class=\"tk\">●</span><span class=\"tk z\">◦</span><span class=\"cup c\">⟆</span> <span class=\"cup o\">⟅</span><span class=\"gl w\">tal</span> <span class=\"tk\">●●</span><span class=\"tk z\">◦</span><span class=\"cup c\">⟆</span></span></div>\n    </div>",
  "mark-as-figure": "<div class=\"rows labeled\">\n      <div class=\"row hand\" data-retrieved=\"p221\" data-hand=\"undecoded\" data-of=\"121211000031211001033023121113021302032233\"><span class=\"lbl\">as it comes</span><span class=\"fig\"><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▪▫▫▫▫</span><span class=\"cup c\">⟆</span><span class=\"fj\">·</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▪▫▫▪▫</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-retrieved=\"p221\" data-hand=\"notation\" data-of=\"121211000031211001033023121113021302032233\"><span class=\"lbl\">as I write it</span><span class=\"fig\"><span class=\"gl sg\" data-s=\"is:square\" data-numerals></span></span></div>\n    </div>",
  "take-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"12113212111302130213021302130203302312101132121113021302130213021302130203321211130213020332233\"></div>\n      <div class=\"rb-note\">A heap lifted off instead of laid on: <span class=\"gl w\" data-sign=\"-\">take</span>.</div>\n    </div>",
  "heap-readback": "<div class=\"readback\">\n      <div class=\"rb-label\">read back</div>\n      <div class=\"row\" data-code=\"121132121113021302130213021302033023121001321211130213021302033212111302130213020332233\"></div>\n      <div class=\"rb-note\">So many of that count, laid together: <span class=\"gl w\" data-sign=\"*\">heap</span>.</div>\n    </div>",
  "circles-retired": "<div class=\"rows labeled\">\n      <div class=\"row hand\" data-retrieved=\"p232\" data-hand=\"notation\" data-of=\"121132121113021302130213020332121113021302130213020332233\"><span class=\"lbl\">as she cut it</span><span class=\"fig\"><span class=\"gl w\">tal</span> <span class=\"tk\">●●●</span><span class=\"tk z\">◦</span></span></div>\n      <div class=\"row hand\" data-retrieved=\"p232\" data-hand=\"notation\" data-of=\"121132121113021302130213020332121113021302130213020332233\"><span class=\"lbl\">the same, in counts</span><span class=\"fig\"><span class=\"gl w\">tal</span> <span class=\"num barred\" data-n=\"1\"></span> <span class=\"num barred\" data-n=\"1\"></span> <span class=\"num barred\" data-n=\"1\"></span> <span class=\"num barred\" data-n=\"0\"></span></span></div>\n    </div>",
  "cut-tests": "<div class=\"rows labeled\">\n      <div class=\"row hand\" data-hand=\"hers\"><span class=\"lbl\">as it comes</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"hers\"><span class=\"lbl\">cut at the doubling</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span><span class=\"seam\"></span><span class=\"seam\"></span><span class=\"seam\"></span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"hers\"><span class=\"lbl\">a tone early</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"seam\"></span><span class=\"seam\"></span><span class=\"seam\"></span><span class=\"cup c\">⟆</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span></span></div>\n      <div class=\"row hand\" data-hand=\"hers\"><span class=\"lbl\">a tone late</span><span class=\"fig\"><span class=\"cup o\">⟅</span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span><span class=\"cup o\">⟅</span><span class=\"seam\"></span><span class=\"seam\"></span><span class=\"seam\"></span><span class=\"bit\">▪</span><span class=\"cup o\">⟅</span><span class=\"bit\">▪▫</span><span class=\"cup c\">⟆</span><span class=\"cup c\">⟆</span></span></div>\n    </div>",
  "two-shapes": "<div class=\"rows labeled\">\n      <div class=\"row\" data-retrieved=\"p232\" data-code=\"12113212111302130203321211130213020332233\"><span class=\"lbl\">the shape my habit was built on</span></div>\n      <div class=\"row\" data-code=\"1211321211130213021302130203302312101032121113021302033212111302130213020332233\"><span class=\"lbl\">and tonight</span></div>\n    </div>"
}
